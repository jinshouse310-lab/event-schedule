# ローカル起動 (npm start) 用。Netlify では Site configuration > Environment variables に設定します。
# Local run (npm start). On Netlify, set these under Site configuration > Environment variables.

# サーバーのポート / Server port (local only)
PORT=3000
# データ保存先 / Data directory (local only)
DATA_DIR=./data
# 共有パスコード。空にすると認証なし / Shared passcode. Leave empty to disable login.
APP_PASSCODE=
# Cookie 署名用の秘密文字列 / Secret used to sign the login cookie
SESSION_SECRET=change-me
# 1ファイルの最大サイズ(MB)。Netlify Functions のリクエスト上限のため Netlify では 4 以下を推奨
# Max upload size per file (MB). Keep at 4 or below on Netlify (function request limit).
MAX_UPLOAD_MB=4
