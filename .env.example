# サーバーのポート / Server port
PORT=3000
# データ保存先 (DB とアップロードファイル) / Data directory (DB + uploads)
DATA_DIR=./data
# 共有パスコード。空にすると認証なし / Shared passcode. Leave empty to disable login.
APP_PASSCODE=
# Cookie 署名用の秘密文字列 / Secret used to sign the login cookie
SESSION_SECRET=change-me
# 1ファイルの最大サイズ(MB) / Max upload size per file (MB)
MAX_UPLOAD_MB=50
